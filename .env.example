# Marquee — every setting the service reads, with its default.
#
#   cp .env.example .env        (.env is git-ignored)
#
# Settings marked REQUIRED have no built-in default: the service refuses to start
# without them, and says which one is missing. Everything else may be left out.
#
# A test fails if this file and app/core/config.py ever declare different settings.
#
# The live demo and docker-compose.yml override three of these on purpose — see
# "Demo overrides" at the end, and the Limitations section of the README.

# ---------------------------------------------------------------- Database
# REQUIRED. PostgreSQL 16.
DATABASE_URL=postgresql://seatres:seatres@localhost:5432/seatres
# Used only by the test suite, which never touches DATABASE_URL's database.
TEST_DATABASE_URL=postgresql://seatres:seatres@localhost:5432/seatres_test

# The pool is sized against what the DATABASE can serve, not against request volume.
# Requests beyond DB_POOL_MAX wait for a connection; they are not refused.
DB_POOL_MIN=5
DB_POOL_MAX=20
# The database's own max_connections. DB_POOL_MAX must be at most this minus 2 (the
# audit writer's connection and one spare); checked at startup.
DB_SERVER_MAX_CONNECTIONS=100
# How long a request waits for a pooled connection before it is refused with a 503.
# Long on purpose: under a burst, waiting is right and a 503 is not.
# Must exceed DB_STATEMENT_TIMEOUT_MS; checked at startup.
DB_ACQUIRE_TIMEOUT_SECONDS=60
# A statement running longer than this is cancelled: a fault, answered 503.
DB_STATEMENT_TIMEOUT_MS=5000
# A request waiting longer than this for a contended seat gives up: a clean 409.
DB_LOCK_TIMEOUT_MS=2000
# DB_STATEMENT_TIMEOUT_MS must be at least DB_LOCK_TIMEOUT_MS + this, so contention
# always surfaces as a 409 and never as a 503; checked at startup.
DB_TIMEOUT_MARGIN_MS=1000
# A transaction left open and idle this long is ended, so it cannot hold seat locks.
DB_IDLE_TXN_TIMEOUT_MS=10000
# /readyz answers 503 if the database does not reply within this.
READYZ_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- Auth
# REQUIRED, 32+ characters. Signs every token; changing it signs everyone out.
JWT_SECRET=dev-only-insecure-key-change-in-production
# How long a signed-in user's token works. After it: 401, and the client refreshes.
ACCESS_TOKEN_TTL_SECONDS=900
# How long a refresh token works (7 days). Guests get none.
REFRESH_TOKEN_TTL_SECONDS=604800
# How long a guest's token works. A guest cannot refresh: this is the whole session.
# Must exceed MAX_HOLD_TTL_SECONDS, or a guest could never confirm the longest hold;
# checked at startup.
GUEST_TOKEN_TTL_SECONDS=3600
PASSWORD_MIN_LENGTH=12
# Password hashing runs in this many threads, so a sign-in flood cannot stall bookings.
PASSWORD_HASH_WORKERS=4
# REQUIRED. The admin account. Created if missing, and its password RESET TO THIS
# VALUE every time the service starts — to change the admin, change these and restart.
# ADMIN_PASSWORD needs 12+ characters. These are the published demo credentials;
# a real deployment keeps them secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=seat-admin-2026

# ---------------------------------------------------------------- Shows and booking
# REQUIRED (all three). The kinds of event a show may be, the one used when a show
# does not say, and the currency used when a show does not say.
ALLOWED_EVENT_KINDS=cinema,concert
DEFAULT_EVENT_KIND=cinema
DEFAULT_CURRENCY=INR
# Seats one user may hold or own in a show, unless the show sets its own.
DEFAULT_PER_USER_LIMIT=4
# For a reserve that asks for a hold: the show's maximum hold, unless the show sets
# its own; and the ceiling a show may set.
DEFAULT_HOLD_TTL_SECONDS=120
MAX_HOLD_TTL_SECONDS=900
MAX_SEATS_PER_SHOW=50000
MAX_SEAT_LABEL_LENGTH=16
# List endpoints: page size when `limit` is omitted, and the most a caller may ask for.
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ---------------------------------------------------------------- Idempotency
# A duplicate of a request still in progress waits up to WAIT, checking every POLL.
IDEMPOTENCY_WAIT_MS=2000
IDEMPOTENCY_POLL_INTERVAL_MS=50
# A key still "in progress" after this long is presumed abandoned and may be taken over.
IDEMPOTENCY_STALE_SECONDS=30
# Written on each key as its expiry. Nothing deletes expired keys yet.
IDEMPOTENCY_RETENTION_HOURS=48
IDEMPOTENCY_KEY_MAX_LENGTH=255
# Sent as Retry-After when a duplicate gives up waiting (409 IDEMPOTENCY_IN_PROGRESS).
IDEMPOTENCY_RETRY_AFTER_SECONDS=1

# ---------------------------------------------------------------- Rate limiting
# Signed-in requests are limited per USER; only sign-in and guest creation are limited
# per client address. Each ceiling is <requests>/<seconds>s. false switches it all
# off, and /readyz reports which.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RESERVE=120/10s
RATE_LIMIT_READ=300/10s
RATE_LIMIT_AUTH=10/60s
RATE_LIMIT_GUEST=60/60s
RATE_LIMIT_ADMIN=30/60s
# Memory bound: idle buckets beyond this many are evicted.
RATE_LIMIT_MAX_BUCKETS=100000
# How many proxies sit in front of the service. The client's address is read that
# many entries from the RIGHT of X-Forwarded-For. 0 ignores the header. It is 3 on
# Render, found by test; a wrong value either merges every client into one bucket or
# limits nobody.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------- Audit trail
# One row per request. Buffered in memory and written in batches on its own database
# connection. When the buffer is full a record is dropped and counted — a request
# never waits for audit.
AUDIT_ENABLED=true
AUDIT_QUEUE_MAX=50000
AUDIT_BATCH_SIZE=500
AUDIT_FLUSH_INTERVAL_MS=500
# How long shutdown waits to write what is still buffered.
AUDIT_SHUTDOWN_FLUSH_SECONDS=5

# ---------------------------------------------------------------- Admin console
# Bounds on what the console may ask for, so no query can scan the whole audit table.
ADMIN_DEFAULT_WINDOW_MINUTES=15
ADMIN_MAX_WINDOW_MINUTES=1440
ADMIN_DEFAULT_ROWS=100
ADMIN_MAX_ROWS=500
# Rows in the "by route" and "declines by reason" tables.
ADMIN_TOP_N=15

# ---------------------------------------------------------------- Metrics and logs
# The most recent shows given a seats_available series on /metrics.
GAUGE_MAX_SHOWS=50
LOG_LEVEL=info
# Log lines waiting to be written to stdout; when full, lines are dropped, not awaited.
LOG_QUEUE_MAX=10000
# Recent log lines kept in memory for the admin console's Logs tab.
LOG_BUFFER_MAX=2000
SERVICE_VERSION=0.1.0

# ---------------------------------------------------------------- Demo overrides
# What the live service and docker-compose.yml set differently, and why:
#
#   RATE_LIMIT_ENABLED=false         a load test from one machine sees 201 and 409,
#                                    never 429
#   ACCESS_TOKEN_TTL_SECONDS=3600    a token minted at the start of a long test still
#                                    works at the end
#   RATE_LIMIT_TRUSTED_PROXY_HOPS=3  Render only (0 under docker compose)
