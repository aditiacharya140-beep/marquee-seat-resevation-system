# Copy to .env for local development. .env is git-ignored.
# Secrets have no defaults — the application refuses to boot without them.

# --- Database ---
DATABASE_URL=postgresql://seatres:seatres@localhost:5432/seatres
TEST_DATABASE_URL=postgresql://seatres:seatres@localhost:5432/seatres_test

# Pool is sized against the server's max_connections (100 locally), not
# against request concurrency. See mds/11-scalability.md.
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_ACQUIRE_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
# DB_STATEMENT_TIMEOUT_MS must be >= DB_LOCK_TIMEOUT_MS + this margin, so a contended
# claim times out on the lock (409) rather than the statement (503). ADR-027.
DB_TIMEOUT_MARGIN_MS=1000
DB_IDLE_TXN_TIMEOUT_MS=10000
# /readyz fails closed if the database does not answer within this.
READYZ_TIMEOUT_SECONDS=2
# The database's own max_connections, read from the server rather than guessed
# (100 on Homebrew Postgres 16 — LEARN-003). DB_POOL_MAX is validated against it
# at startup, less the audit writer's dedicated connection.
DB_SERVER_MAX_CONNECTIONS=100

# --- Auth (no defaults in production) ---
JWT_SECRET=dev-only-insecure-key-change-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Must exceed DEFAULT_HOLD_TTL_SECONDS plus a margin, or a guest's token
# expires before they can confirm. Validated at startup.
GUEST_TOKEN_TTL_SECONDS=3600
PASSWORD_MIN_LENGTH=12
# Argon2 runs in a bounded thread pool so a login flood cannot stall the event loop.
PASSWORD_HASH_WORKERS=4
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-only-change-me-now

# --- Domain defaults ---
# event_kind is configuration, not an enum — a new vertical needs no code change. ADR-025.
ALLOWED_EVENT_KINDS=cinema,concert
DEFAULT_EVENT_KIND=cinema
DEFAULT_CURRENCY=INR
DEFAULT_PER_USER_LIMIT=4
DEFAULT_HOLD_TTL_SECONDS=120
MAX_HOLD_TTL_SECONDS=900
MAX_SEATS_PER_SHOW=5000
MAX_SEAT_LABEL_LENGTH=16
# List endpoints: page size when `limit` is omitted, and its ceiling.
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# --- Rate limiting (per-identity; ceilings tunable without redeploy) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RESERVE=120/10s
RATE_LIMIT_READ=300/10s
RATE_LIMIT_AUTH=10/60s
RATE_LIMIT_GUEST=60/60s
RATE_LIMIT_ADMIN=30/60s

# --- Audit (never blocks the request path) ---
AUDIT_ENABLED=true
AUDIT_QUEUE_MAX=50000
AUDIT_BATCH_SIZE=500
AUDIT_FLUSH_INTERVAL_MS=200

# --- Workers ---
GAUGE_REFRESH_SECONDS=2
GAUGE_MAX_SHOWS=50

# --- Idempotency ---
IDEMPOTENCY_WAIT_MS=2000
IDEMPOTENCY_POLL_INTERVAL_MS=50
IDEMPOTENCY_STALE_SECONDS=30
IDEMPOTENCY_RETENTION_HOURS=48
IDEMPOTENCY_KEY_MAX_LENGTH=255
# Retry-After on 409 IDEMPOTENCY_IN_PROGRESS.
IDEMPOTENCY_RETRY_AFTER_SECONDS=1

# --- Observability ---
LOG_LEVEL=info
LOG_SAMPLE_DEBUG=false
# Lines buffered between the event loop and the stdout writer thread; full drops.
LOG_QUEUE_MAX=10000
SERVICE_VERSION=0.1.0
